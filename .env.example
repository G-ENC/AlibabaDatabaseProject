# Copy to .env on the server and change the values. Every value has a default,
# so `docker compose up` works without this file.
JWT_SECRET=change-me-to-a-long-random-string
# Database password. Change it BEFORE the first start (it is only applied when the volume is created).
DB_PASSWORD=change-me-too
# Keep false while the site is served over plain http://<ip>. Set true only with HTTPS.
COOKIE_SECURE=false
